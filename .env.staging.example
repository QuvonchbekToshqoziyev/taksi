APP_ENV="staging"
DATABASE_URL="postgresql://taxi_bot_staging:CHANGE_ME@127.0.0.1:5432/taksi_staging?schema=public"

# Must be a different bot from production.
BOT_TOKEN=""
SUPERADMIN_TG_ID=""

# Keep false for full identity isolation. Set true only when the same
# superadmin intentionally manages production and staging.
STAGING_ALLOW_PRODUCTION_SUPERADMIN="false"

# Comma-separated test accounts only: admin, clients and drivers.
STAGING_ALLOWED_USER_IDS=""

# Comma-separated test group/channel IDs. The allowed superadmin may use
# /getid in a new group before adding it here.
STAGING_ALLOWED_CHAT_IDS=""

# Must use a different Telegram user account/session from production.
TG_API_ID=""
TG_API_HASH=""
TG_SESSION=""
